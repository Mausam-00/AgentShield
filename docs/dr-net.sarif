{
  "version": "2.1.0",
  "$schema": "sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AgentShield AI",
          "version": "1.0.0",
          "rules": [
            {
              "id": "SA-01",
              "name": "Danglingdependencyreferences",
              "shortDescription": {
                "text": "Dangling dependency references"
              },
              "fullDescription": {
                "text": "Referenced protocol/template/knowledge assets do not exist"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "control-family": "ASF-08 Monitoring, auditability, and evidence retention",
                "tags": [
                  "agentshield",
                  "ai-governance",
                  "ASF-08"
                ]
              },
              "help": {
                "text": "Ship the referenced assets alongside the agent, or make the agent degrade gracefully and announce when they are absent."
              }
            },
            {
              "id": "SA-02",
              "name": "Declaredworkingdirectorydoesnotexist",
              "shortDescription": {
                "text": "Declared working directory does not exist"
              },
              "fullDescription": {
                "text": "Declared working directory is not present on this host"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
                "control-family": "ASF-09 Fail-closed behavior, resilience, and recovery",
                "tags": [
                  "agentshield",
                  "ai-governance",
                  "ASF-09"
                ]
              },
              "help": {
                "text": "Point the working directory to a path that exists, or make it configurable / relative to the install location."
              }
            },
            {
              "id": "SA-03",
              "name": "Over-privilegedtoolgrantversusrole",
              "shortDescription": {
                "text": "Over-privileged tool grant versus role"
              },
              "fullDescription": {
                "text": "Write-capable tools granted to an analysis/diagnostic role"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.0",
                "control-family": "ASF-03 Tool inventory, permissions, and least privilege",
                "tags": [
                  "agentshield",
                  "ai-governance",
                  "ASF-03"
                ]
              },
              "help": {
                "text": "Remove write tools unless a concrete write use-case exists; if retained, restrict writes to a declared output directory."
              }
            },
            {
              "id": "SA-05",
              "name": "Unversioneddefinitionwithnointegritymarker",
              "shortDescription": {
                "text": "Unversioned definition with no integrity marker"
              },
              "fullDescription": {
                "text": "No version/revision field present"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "security-severity": "2.0",
                "control-family": "ASF-10 Definition, manifest, and policy version integrity",
                "tags": [
                  "agentshield",
                  "ai-governance",
                  "ASF-10"
                ]
              },
              "help": {
                "text": "Add a version field and an integrity/hash marker."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SA-01",
          "level": "error",
          "message": {
            "text": "Missing referenced assets: Protocols/NET.md, Templates/engineer-report.md\nImpact: 'Always reference' instructions silently no-op or error, degrading output quality without the operator knowing.\nRemediation: Ship the referenced assets alongside the agent, or make the agent degrade gracefully and announce when they are absent."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "dr-net.agent.md"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "evidence-state": "Observed",
            "control-family": "ASF-08 Monitoring, auditability, and evidence retention"
          }
        },
        {
          "ruleId": "SA-02",
          "level": "error",
          "message": {
            "text": "Working directory 'E:\\CLI' was not found.\nImpact: Relative asset paths resolve against a non-existent root.\nRemediation: Point the working directory to a path that exists, or make it configurable / relative to the install location."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "dr-net.agent.md"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "evidence-state": "Observed",
            "control-family": "ASF-09 Fail-closed behavior, resilience, and recovery"
          }
        },
        {
          "ruleId": "SA-03",
          "level": "warning",
          "message": {
            "text": "Write-capable tools granted: edit, create\nImpact: Write capability exceeds least privilege and widens the trust boundary.\nRemediation: Remove write tools unless a concrete write use-case exists; if retained, restrict writes to a declared output directory."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "dr-net.agent.md"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "evidence-state": "Observed",
            "control-family": "ASF-03 Tool inventory, permissions, and least privilege"
          }
        },
        {
          "ruleId": "SA-05",
          "level": "note",
          "message": {
            "text": "No 'version:' field found in the definition.\nImpact: Assurance freshness and definition-hash binding cannot be established.\nRemediation: Add a version field and an integrity/hash marker."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "dr-net.agent.md"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "evidence-state": "Observed",
            "control-family": "ASF-10 Definition, manifest, and policy version integrity"
          }
        }
      ],
      "properties": {
        "assurance_posture": "WARN",
        "assurance_score": 62,
        "coverage": 1.0,
        "confidence": "MEDIUM",
        "runtime_decision": null,
        "note": "Assurance posture is not runtime authorization."
      }
    }
  ]
}